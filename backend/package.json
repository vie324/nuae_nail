{
  "name": "@nuae/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Nuae Nail backend - external reservation ingestion (Phase 1+2: API + parsers)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "parse":         "tsx src/cli/parse.ts",
    "demo":          "tsx src/cli/parse.ts --all",
    "ingest":        "tsx src/cli/ingest.ts",
    "scrape":        "tsx src/cli/scrape.ts",
    "test":          "vitest run",
    "test:watch":    "vitest",
    "typecheck":     "tsc --noEmit",
    "db:migrate":    "tsx src/db/migrate.ts",
    "imap:watch":    "tsx src/imap/watcher.ts",
    "dev:api":       "tsx watch src/api/server.ts",
    "dev:worker":    "tsx watch src/queue/worker.ts",
    "start:api":     "tsx src/api/server.ts",
    "start:worker":  "tsx src/queue/worker.ts",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bullmq":        "^5.7.0",
    "dotenv":        "^16.4.5",
    "fastify":       "^4.26.2",
    "imapflow":      "^1.0.158",
    "ioredis":       "^5.3.2",
    "mailparser":    "^3.6.5",
    "pg":            "^8.11.3",
    "playwright":    "^1.42.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node":       "^20.11.0",
    "@types/pg":         "^8.11.0",
    "pino-pretty":       "^11.0.0",
    "tsx":               "^4.7.0",
    "typescript":        "^5.3.3",
    "vitest":            "^1.2.0"
  }
}
