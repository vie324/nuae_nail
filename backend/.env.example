# =====================================================================
# Nuae Backend - Environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ─── IMAP (Phase 2) ────────────────────────────────────────────────
# サロンが minimo / HPB の通知を受け取る受信箱
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=salon-inbox@nuae.jp
# Gmail はアプリパスワード推奨。OAuth2 の場合は別変数で。
IMAP_PASSWORD=
# 取りに行く mailbox。Gmail なら `INBOX`、ラベル運用なら `[Gmail]/Reservations` 等
IMAP_MAILBOX=INBOX

# ─── Database (Phase 1, 後で使用) ─────────────────────────────────
DATABASE_URL=postgres://nuae:nuae@localhost:5432/nuae_dev

# ─── Redis / BullMQ (Phase 1) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server (Phase 1) ─────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info

# ─── Scrapers (Phase 3) ───────────────────────────────────────────
# 暗号化保存される。空でOK（Phase 2では未使用）
SALONBOARD_USER=
SALONBOARD_PASSWORD=
MINIMO_USER=
MINIMO_PASSWORD=
