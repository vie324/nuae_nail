# =====================================================================
# Nuae Backend - Environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

NODE_ENV=development
LOG_LEVEL=info

# ─── API server ─────────────────────────────────────────────────────
PORT=4000
# Comma-separated origins, or "*" for any. For local dev with the
# static frontend opened via file:// or :8080, use "*".
CORS_ORIGIN=*

# ─── Database ───────────────────────────────────────────────────────
# docker-compose で立ち上げる場合はそのままでOK
DATABASE_URL=postgres://nuae:nuae@localhost:5432/nuae_dev

# ─── Redis / BullMQ ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── IMAP (mail ingest) ─────────────────────────────────────────────
# サロンが minimo / HPB の通知を受け取る受信箱
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=salon-inbox@nuae.jp
# Gmail はアプリパスワード推奨。OAuth2 の場合は別変数で。
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# ─── Scrapers (Phase 3) ─────────────────────────────────────────────
# 各プラットフォームのログイン情報。空のままだと該当スクレイパーは起動しません。
SALONBOARD_USER=
SALONBOARD_PASSWORD=
MINIMO_USER=
MINIMO_PASSWORD=

# Playwright headless (false にすると目視で挙動を確認できる)
SCRAPER_HEADLESS=true
# 保存先 (storageState を保持してログインを再利用)
SCRAPER_SESSION_DIR=./.sessions

# ─── Notifications (optional) ───────────────────────────────────────
# 再ログインが必要になったとき LINE でオーナーへ通知
LINE_ACCESS_TOKEN=
LINE_OWNER_USER_ID=
